<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> | AutoCare Manager</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <!-- Main Navigation Header -->
    <header class="site-nav">
        <div class="nav-inner">
            <a href="/" class="nav-brand">
                <div class="brand-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/>
                        <circle cx="7" cy="17" r="2"/>
                        <path d="M9 17h6"/>
                        <circle cx="17" cy="17" r="2"/>
                    </svg>
                </div>
                <div class="brand-text">
                    <h1>AutoCare Manager</h1>
                    <span>Fleet &amp; Service Operations</span>
                </div>
            </a>

            <nav class="nav-menu">
                <a href="/" class="nav-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a>
                <a href="/vehicles" class="nav-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
                    Vehicles
                </a>
                <a href="/services/book" class="nav-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                    Book Service
                </a>
                <a href="/admin/dashboard" class="nav-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a>
                <a href="/admin/services" class="nav-link active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    Service Center
                </a>

                <% if (currentUser) { %>
                    <div style="display: flex; align-items: center; gap: 8px; margin-left: 10px; padding-left: 12px; border-left: 1px solid rgba(255,255,255,0.15);">
                        <span style="font-size: 13px; color: #38bdf8; font-weight: 600;">
                            <%= currentRole === 'admin' ? '🏭 Admin: ' : '🚗 ' %><%= currentUser %>
                        </span>
                        <a href="/logout" class="btn btn-outline btn-sm" style="background: rgba(255,255,255,0.06); color: #f87171; border-color: rgba(248,113,113,0.3); font-size: 11px; padding: 4px 8px;">
                            Logout
                        </a>
                    </div>
                <% } else { %>
                    <div style="display: flex; align-items: center; gap: 8px; margin-left: 10px; padding-left: 12px; border-left: 1px solid rgba(255,255,255,0.15);">
                        <a href="/login" class="btn btn-primary btn-sm" style="font-size: 12px; padding: 6px 12px;">Sign In</a>
                    </div>
                <% } %>
            </nav>
        </div>
    </header>

    <main class="main-wrapper">

        <div class="page-header">
            <div class="page-title">
                <h1>Service Center Operations Portal</h1>
                <p>Manage incoming maintenance requests, triage repair orders, and complete workshop job sheets</p>
            </div>
            <a href="/services/book" class="btn btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Log New Request
            </a>
        </div>

        <!-- Operations KPI Strip -->
        <% 
            const pendingCount = services.filter(s => s.status === 'Pending').length;
            const acceptedCount = services.filter(s => s.status === 'Accepted').length;
            const completedCount = services.filter(s => s.status === 'Completed').length;
            const totalRevenue = services.filter(s => s.status === 'Completed').reduce((sum, s) => sum + (s.cost || 0), 0);
        %>
        <div class="kpi-grid" style="margin-bottom: 28px;">
            <div class="kpi-card" style="padding: 18px;">
                <span class="kpi-label">Total Jobs Logged</span>
                <div class="kpi-value" style="font-size: 26px; margin: 8px 0 0;"><%= services.length %></div>
            </div>
            <div class="kpi-card" style="padding: 18px;">
                <span class="kpi-label">Pending Triage</span>
                <div class="kpi-value" style="font-size: 26px; margin: 8px 0 0; color: #d97706;"><%= pendingCount %></div>
            </div>
            <div class="kpi-card" style="padding: 18px;">
                <span class="kpi-label">Work In Progress</span>
                <div class="kpi-value" style="font-size: 26px; margin: 8px 0 0; color: #0284c7;"><%= acceptedCount %></div>
            </div>
            <div class="kpi-card" style="padding: 18px;">
                <span class="kpi-label">Completed Invoices</span>
                <div class="kpi-value" style="font-size: 26px; margin: 8px 0 0; color: #059669;">₹<%= totalRevenue.toLocaleString('en-IN') %></div>
            </div>
        </div>

        <div class="table-panel">
            <div class="table-panel-header">
                <h3>Repair Order Management Table</h3>
                <span style="font-size: 13px; color: var(--text-muted);"><%= services.length %> Total Record(s)</span>
            </div>

            <div class="table-responsive">
                <% if (services.length === 0) { %>
                    <div class="empty-state">
                        <div class="empty-icon">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                        </div>
                        <h3>No Service Requests Recorded</h3>
                        <p>No customer service requests or repair orders are currently logged in the workshop system.</p>
                        <a href="/services/book" class="btn btn-primary">Create First Request</a>
                    </div>
                <% } else { %>
                    <table class="saas-table">
                        <thead>
                            <tr>
                                <th>Registration &amp; Date</th>
                                <th>Service Scope</th>
                                <th>Driver Concern / Notes</th>
                                <th>Status</th>
                                <th>Parts Replaced</th>
                                <th>Billed Cost</th>
                                <th style="text-align: right;">Operations</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% services.forEach((s) => { %>
                                <tr>
                                    <td>
                                        <a href="/vehicles/<%= s.vehicleNumber %>/history" style="text-decoration: none;">
                                            <span class="reg-plate" style="margin-bottom: 4px; font-size: 13px; padding: 4px 8px;">
                                                <span class="reg-plate-ind">IND</span>
                                                <%= s.vehicleNumber %>
                                            </span>
                                        </a>
                                        <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                                            Booked: <%= new Date(s.bookingDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                        </div>
                                    </td>
                                    <td><strong><%= s.serviceType %></strong></td>
                                    <td style="color: var(--text-secondary); max-width: 240px;">
                                        <%= s.issueDescription %>
                                    </td>
                                    <td>
                                        <% if (s.status === 'Pending') { %>
                                            <span class="status-pill pill-pending">Pending Triage</span>
                                        <% } else if (s.status === 'Accepted') { %>
                                            <span class="status-pill pill-accepted">In Progress</span>
                                        <% } else if (s.status === 'Completed') { %>
                                            <span class="status-pill pill-completed">Completed</span>
                                        <% } else if (s.status === 'Rejected') { %>
                                            <span class="status-pill pill-rejected">Rejected</span>
                                        <% } %>
                                    </td>
                                    <td style="font-size: 13px; color: var(--text-secondary); max-width: 200px;">
                                        <%= s.partsReplaced && s.partsReplaced !== 'None' ? s.partsReplaced : '-' %>
                                    </td>
                                    <td>
                                        <% if (s.cost > 0) { %>
                                            <strong style="color: #047857; font-size: 15px;">₹<%= s.cost.toLocaleString('en-IN') %></strong>
                                        <% } else { %>
                                            <span style="color: var(--text-light); font-size: 13px;">Unbilled</span>
                                        <% } %>
                                    </td>
                                    <td style="text-align: right;">
                                        <div style="display: inline-flex; gap: 6px;">
                                            <% if (s.status === 'Pending') { %>
                                                <a href="/admin/services/<%= s._id %>/status?status=Accepted" class="btn btn-success btn-sm">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                                    Accept
                                                </a>
                                                <a href="/admin/services/<%= s._id %>/status?status=Rejected" class="btn btn-danger btn-sm" onclick="return confirm('Reject service request for <%= s.vehicleNumber %>?');">
                                                    Reject
                                                </a>
                                            <% } else if (s.status === 'Accepted') { %>
                                                <a href="/admin/services/<%= s._id %>/complete" class="btn btn-primary btn-sm">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                                                    Record &amp; Complete
                                                </a>
                                            <% } else if (s.status === 'Completed') { %>
                                                <a href="/admin/services/<%= s._id %>/complete" class="btn btn-outline btn-sm">
                                                    Edit Job Sheet
                                                </a>
                                            <% } else { %>
                                                <a href="/admin/services/<%= s._id %>/status?status=Accepted" class="btn btn-outline btn-sm">
                                                    Re-Open
                                                </a>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>

    </main>

    <footer class="site-footer">
        <p>&copy; 2026 AutoCare Manager &bull; Enterprise Automotive Service &amp; Fleet Management Platform</p>
    </footer>

</body>
</html>
