<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> | AutoCare Manager</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <!-- Main Navigation Header -->
    <header class="site-nav">
        <div class="nav-inner">
            <a href="/" class="nav-brand">
                <div class="brand-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/>
                        <circle cx="7" cy="17" r="2"/>
                        <path d="M9 17h6"/>
                        <circle cx="17" cy="17" r="2"/>
                    </svg>
                </div>
                <div class="brand-text">
                    <h1>AutoCare Manager</h1>
                    <span>Fleet &amp; Service Operations</span>
                </div>
            </a>

            <nav class="nav-menu">
                <% if (currentRole === 'admin') { %>
                    <a href="/admin/dashboard" class="nav-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        Admin Dashboard
                    </a>
                    <a href="/admin/services" class="nav-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                        Job Operations
                    </a>
                    <a href="/vehicles" class="nav-link active">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
                        Workshop Fleet
                    </a>
                <% } else { %>
                    <a href="/owner/dashboard" class="nav-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        My Dashboard
                    </a>
                    <a href="/vehicles" class="nav-link active">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
                        My Vehicles
                    </a>
                    <a href="/services/book" class="nav-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                        Book Service
                    </a>
                <% } %>

                <% if (currentUser) { %>
                    <div style="display: flex; align-items: center; gap: 8px; margin-left: 10px; padding-left: 12px; border-left: 1px solid rgba(255,255,255,0.15);">
                        <span style="font-size: 13px; color: #38bdf8; font-weight: 600;">
                            <%= currentRole === 'admin' ? '🏭 Admin: ' : '🚗 ' %><%= currentUser %>
                        </span>
                        <a href="/logout" class="btn btn-outline btn-sm" style="background: rgba(255,255,255,0.06); color: #f87171; border-color: rgba(248,113,113,0.3); font-size: 11px; padding: 4px 8px;">
                            Logout
                        </a>
                    </div>
                <% } else { %>
                    <div style="display: flex; align-items: center; gap: 8px; margin-left: 10px; padding-left: 12px; border-left: 1px solid rgba(255,255,255,0.15);">
                        <a href="/login" class="btn btn-primary btn-sm" style="font-size: 12px; padding: 6px 12px;">Sign In</a>
                    </div>
                <% } %>
            </nav>
        </div>
    </header>

    <main class="main-wrapper">

        <div class="form-shell">
            <div class="form-shell-header">
                <h2>Register Vehicle Profile</h2>
                <p>Enter vehicle identification, odometer readings, and ownership details</p>
            </div>

            <div class="form-shell-body">
                <form action="/vehicles/add" method="POST">

                    <!-- Section 1 -->
                    <div class="form-section-title">01 &bull; Vehicle Specifications</div>

                    <div class="form-grid-2">
                        <div class="form-group">
                            <label for="vehicleNumber">Registration Number <span class="req">*</span></label>
                            <input type="text" id="vehicleNumber" name="vehicleNumber" class="form-control" placeholder="e.g. DL-04-XY-9999" required style="text-transform: uppercase; font-family: monospace; font-weight: 700; letter-spacing: 1px;">
                            <div class="input-hint">Official state registration plate format</div>
                        </div>

                        <div class="form-group">
                            <label for="model">Make &amp; Model <span class="req">*</span></label>
                            <input type="text" id="model" name="model" class="form-control" placeholder="e.g. Hyundai Creta 1.5 SX" required>
                            <div class="input-hint">Manufacturer, model name and trim</div>
                        </div>
                    </div>

                    <!-- Section 2 -->
                    <div class="form-section-title">02 &bull; Usage &amp; Ownership Metrics</div>

                    <div class="form-grid-2">
                        <div class="form-group">
                            <label for="currentMileage">Current Mileage (km) <span class="req">*</span></label>
                            <input type="number" id="currentMileage" name="currentMileage" class="form-control" placeholder="e.g. 14500" required min="0">
                            <div class="input-hint">Values &ge; 10,000 km trigger automated service due alerts</div>
                        </div>

                        <div class="form-group">
                            <label for="purchaseDate">Purchase Date <span class="req">*</span></label>
                            <input type="date" id="purchaseDate" name="purchaseDate" class="form-control" required>
                            <div class="input-hint">Vehicle delivery or registration date</div>
                        </div>
                    </div>

                    <div class="form-grid-2">
                        <div class="form-group">
                            <label for="ownerName">Primary Owner Name <span class="req">*</span></label>
                            <input type="text" id="ownerName" name="ownerName" class="form-control" placeholder="e.g. Rajesh Kumar" required>
                        </div>

                        <div class="form-group">
                            <label for="ownerPhone">Contact Phone Number</label>
                            <input type="tel" id="ownerPhone" name="ownerPhone" class="form-control" placeholder="e.g. +91 98765 43210">
                        </div>
                    </div>

                    <div class="form-actions-bar">
                        <a href="/vehicles" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                            Register Vehicle
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </main>

    <footer class="site-footer">
        <p>&copy; 2026 AutoCare Manager &bull; Enterprise Automotive Service &amp; Fleet Management Platform</p>
    </footer>

</body>
</html>
