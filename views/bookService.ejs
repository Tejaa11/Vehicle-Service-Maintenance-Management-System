<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> | AutoCare Manager</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <!-- Main Navigation Header -->
    <header class="site-nav">
        <div class="nav-inner">
            <a href="/" class="nav-brand">
                <div class="brand-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/>
                        <circle cx="7" cy="17" r="2"/>
                        <path d="M9 17h6"/>
                        <circle cx="17" cy="17" r="2"/>
                    </svg>
                </div>
                <div class="brand-text">
                    <h1>AutoCare Manager</h1>
                    <span>Fleet &amp; Service Operations</span>
                </div>
            </a>

            <nav class="nav-menu">
                <% if (currentRole === 'admin') { %>
                    <a href="/admin/dashboard" class="nav-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        Admin Dashboard
                    </a>
                    <a href="/admin/services" class="nav-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                        Job Operations
                    </a>
                    <a href="/vehicles" class="nav-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
                        Workshop Fleet
                    </a>
                <% } else { %>
                    <a href="/owner/dashboard" class="nav-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        My Dashboard
                    </a>
                    <a href="/vehicles" class="nav-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
                        My Vehicles
                    </a>
                    <a href="/services/book" class="nav-link active">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                        Book Service
                    </a>
                <% } %>

                <% if (currentUser) { %>
                    <div style="display: flex; align-items: center; gap: 8px; margin-left: 10px; padding-left: 12px; border-left: 1px solid rgba(255,255,255,0.15);">
                        <span style="font-size: 13px; color: #38bdf8; font-weight: 600;">
                            <%= currentRole === 'admin' ? '🏭 Admin: ' : '🚗 ' %><%= currentUser %>
                        </span>
                        <a href="/logout" class="btn btn-outline btn-sm" style="background: rgba(255,255,255,0.06); color: #f87171; border-color: rgba(248,113,113,0.3); font-size: 11px; padding: 4px 8px;">
                            Logout
                        </a>
                    </div>
                <% } else { %>
                    <div style="display: flex; align-items: center; gap: 8px; margin-left: 10px; padding-left: 12px; border-left: 1px solid rgba(255,255,255,0.15);">
                        <a href="/login" class="btn btn-primary btn-sm" style="font-size: 12px; padding: 6px 12px;">Sign In</a>
                    </div>
                <% } %>
            </nav>
        </div>
    </header>

    <main class="main-wrapper">

        <div class="form-shell">
            <div class="form-shell-header">
                <h2>Service Intake &amp; Problem Dispatch</h2>
                <p>Book a workshop appointment or submit automotive breakdown symptoms</p>
            </div>

            <div class="form-shell-body">
                <form action="/services/book" method="POST">

                    <!-- Step 1: Select Vehicle -->
                    <div class="form-section-title">01 &bull; Target Vehicle</div>

                    <div class="form-group">
                        <label for="vehicleNumber">Select Vehicle Registration Plate <span class="req">*</span></label>
                        <% if (vehicles && vehicles.length > 0) { %>
                            <select id="vehicleNumber" name="vehicleNumber" class="form-control" required style="font-weight: 600;">
                                <option value="">-- Choose from Registered Fleet --</option>
                                <% vehicles.forEach((v) => { %>
                                    <option value="<%= v.vehicleNumber %>" <%= prefillVehicle === v.vehicleNumber ? 'selected' : '' %>>
                                        <%= v.vehicleNumber %> &mdash; <%= v.model %> (Owner: <%= v.ownerName %>, Mileage: <%= v.currentMileage.toLocaleString('en-IN') %> km)
                                    </option>
                                <% }) %>
                            </select>
                            <div class="input-hint">
                                Need to service an unregistered car? <a href="/vehicles/add" style="color: var(--brand-primary); font-weight: 600;">Register new vehicle</a>
                            </div>
                        <% } else { %>
                            <input type="text" id="vehicleNumber" name="vehicleNumber" class="form-control" placeholder="e.g. DL-04-XY-9999" value="<%= prefillVehicle %>" required style="text-transform: uppercase; font-family: monospace; font-weight: 700;">
                            <div class="input-hint">No vehicles in registry. Type plate number directly.</div>
                        <% } %>
                    </div>

                    <!-- Step 2: Service Category -->
                    <div class="form-section-title">02 &bull; Service Category</div>

                    <div class="form-group">
                        <label for="serviceType">Requested Service Type <span class="req">*</span></label>
                        <select id="serviceType" name="serviceType" class="form-control" required>
                            <option value="">-- Select Standard Job or Concern --</option>
                            <option value="General Periodic Maintenance">General Periodic Maintenance (Oil, Filters &amp; 40-pt Check)</option>
                            <option value="Engine Oil & Filter Change">Engine Oil &amp; Filter Replacement</option>
                            <option value="Brake System Inspection / Overhaul">Brake System Inspection / Pad Overhaul</option>
                            <option value="Battery / Electrical Diagnostics">Battery, Alternator &amp; Electrical Diagnostics</option>
                            <option value="Suspension & Wheel Alignment">Suspension Overhaul &amp; 3D Wheel Alignment</option>
                            <option value="Report Specific Problem / Breakdown">Report Specific Breakdown / Engine Warning Light</option>
                        </select>
                    </div>

                    <!-- Step 3: Issue Description -->
                    <div class="form-section-title">03 &bull; Symptoms &amp; Diagnostic Details</div>

                    <div class="form-group">
                        <label for="issueDescription">Report Problem / Specific Symptoms</label>
                        <textarea id="issueDescription" name="issueDescription" class="form-control" rows="4" placeholder="Describe any noises (squeaks, grinding), warning lights, fluid leaks, or specific inspection instructions for the technician..."></textarea>
                        <div class="input-hint">Provide as much detail as possible to assist workshop pre-inspection</div>
                    </div>

                    <div class="form-actions-bar">
                        <a href="/" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                            Dispatch Service Request
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </main>

    <footer class="site-footer">
        <p>&copy; 2026 AutoCare Manager &bull; Enterprise Automotive Service &amp; Fleet Management Platform</p>
    </footer>

</body>
</html>
